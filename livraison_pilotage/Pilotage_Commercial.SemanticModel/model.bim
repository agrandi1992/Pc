          {
            "type": "calculated",
            "name": "anciennete_mandataire_v5",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "VAR d = dim_mandataire[date_passage_mia] VAR m = IF ( ISBLANK ( d ), BLANK (), DATEDIFF ( d, TODAY (), MONTH ) ) RETURN SWITCH ( TRUE (), ISBLANK ( m ), \"nd\", m < 6, \"0-6 mois\", m < 12, \"6-12 mois\", m < 24, \"12-24 mois\", \"24+ mois\" )",
            "summarizeBy": "none",
            "lineageTag": "0c6e805d-6f6a-45e2-9967-863ede392159",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
