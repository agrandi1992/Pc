        "partitions": [
          {
            "name": "dim_date",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "",
                "VAR MinDate = DATE ( 2020, 1, 1 )",
                "VAR MaxDate = TODAY ()",
                "RETURN",
                "ADDCOLUMNS ( CALENDAR ( MinDate, MaxDate ),",
                "\"date_id\", YEAR ( [Date] ) * 10000 + MONTH ( [Date] ) * 100 + DAY ( [Date] ),",
                "\"annee\", YEAR ( [Date] ),",
                "\"annee_mois\", FORMAT ( [Date], \"YYYY-MM\" ),",
                "\"numero_mois\", MONTH ( [Date] ),",
                "\"nom_du_mois\", FORMAT ( [Date], \"MMMM\" ),",
                "\"mois_court\", FORMAT ( [Date], \"MMM\" ),",
                "\"trimestre\", \"Q\" & FORMAT ( [Date], \"Q\" ),",
                "\"numero_de_la_semaine\", WEEKNUM ( [Date], 2 ),",
                "\"numero_du_jour_de_la_semaine\", WEEKDAY ( [Date], 2 ),",
                "\"jour_de_la_semaine\", FORMAT ( [Date], \"DDDD\" ),",
                "\"weekend\", IF ( WEEKDAY ( [Date], 2 ) >= 6, TRUE (), FALSE () )",
                ")"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_Id",
            "value": "bafdfad88afd4fa2ba51953bbe2b86f3"
          }
        ]
