            "name": "fact_parcours_candidat",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Source = #table(\n        type table [candidat_id = text, date_etape_parcours = date, etape_parcours_id = text,\n                    motif_depart_formation_id = text, score_examen = number],\n        {\n            {\"CAN001\",#date(2018,1,15),\"ETP001\",null,  15.5},\n            {\"CAN002\",#date(2018,9,20),\"ETP001\",null,  17.0},\n            {\"CAN003\",#date(2017,3,10),\"ETP001\",null,  14.0},\n            {\"CAN004\",#date(2021,1,5), \"ETP001\",null,  16.5},\n            {\"CAN005\",#date(2020,4,1), \"ETP002\",\"MOT001\",null},\n            {\"CAN006\",#date(2021,10,1),\"ETP001\",null,  18.0},\n            {\"CAN007\",#date(2015,11,1),\"ETP001\",null,  13.5},\n            {\"CAN008\",#date(2020,6,1), \"ETP001\",null,  15.0}\n        }\n    )\nin Source"
            }
          }
        ],
        "isHidden": true
      },
      {
        "name": "fact_activite_mandataire",
        "lineageTag": "975df5cb-8ffc-44ea-b05d-518915f13852",
