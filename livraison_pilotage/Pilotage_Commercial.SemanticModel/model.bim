              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "fact_activite_mandataire",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Source = #table(\n        type table [mandataire_id = text, agence_id = text, date_connexion = date, flag_connexion = logical],\n        {\n            {\"MAN001\",\"AGE001\",#date(2024,1,15),true},\n            {\"MAN001\",\"AGE001\",#date(2024,2,20),true},\n            {\"MAN002\",\"AGE002\",#date(2024,1,22),true},\n            {\"MAN002\",\"AGE002\",#date(2024,3,10),true},\n            {\"MAN003\",\"AGE001\",#date(2024,2,5), true},\n            {\"MAN004\",\"AGE003\",#date(2024,3,3), true},\n            {\"MAN006\",\"AGE004\",#date(2024,4,8), true},\n            {\"MAN007\",\"AGE005\",#date(2024,5,12),true},\n            {\"MAN008\",\"AGE003\",#date(2024,6,10),true}\n        }\n    )\nin Source"
            }
          }
        ],
        "measures": [
          {
            "name": "Flag mandataire actif",
            "expression": [
              "",
              "VAR DateContexteMax =",
              "    MAX(dim_date[Date])",
              "VAR DateLimite =",
              "    DateContexteMax - 30",
              "",
              "VAR NbConnexions =",
              "    CALCULATE(",
              "        DISTINCTCOUNT(fact_activite_mandataire[date_connexion]),",
              "        fact_activite_mandataire[flag_connexion] = 1,",
              "        fact_activite_mandataire[date_connexion] >= DateLimite,",
              "        fact_activite_mandataire[date_connexion] <= DateContexteMax",
              "    )",
              "",
              "RETURN",
              "IF(NbConnexions > 0, \"Actif\", \"Inactif\")"
            ],
            "lineageTag": "ac2ee2df-0cd1-4494-963d-ce6ff8ed1dc1",
            "changedProperties": [
              {
                "property": "Name"
              }
            ],
            "displayFolder": "Pilotage Commercial - Réseau",
            "isHidden": true
          }
        ]
      },
      {
        "name": "_Indicateurs",
        "lineageTag": "aceac64d-589e-41ce-841d-56e859ed91f2",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "kpi",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[kpi]",
            "formatString": "0",
            "displayFolder": "Développement Réseau",
            "lineageTag": "ef57d553-4904-4bff-85ed-27ba8fad9408",
            "summarizeBy": "sum",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "_Indicateurs",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "Row(\"kpi\", BLANK())"
            }
          }
        ],
        "measures": [
          {
            "name": "Nombre rendez-vous prévus",
            "expression": [
              "",
              "DISTINCTCOUNT ( bridge_rendez_vous_mandataire[rendez_vous_id] )"
            ],
            "formatString": "0",
            "displayFolder": "02. Rendez-vous",
            "lineageTag": "8c67fdf8-3c11-4686-8f4d-6f12b4d6ef1a"
          },
          {
            "name": "Nombre rendez-vous réalisés",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT ( bridge_rendez_vous_mandataire[rendez_vous_id] ),",
              "    fact_rendez_vous_client[flag_rendez_vous_realise] = TRUE()",
              ")",
              ""
            ],
            "formatString": "0",
            "displayFolder": "02. Rendez-vous",
            "lineageTag": "6190be98-4886-43e1-80f3-71bda7888272"
          },
          {
            "name": "Taux réalisation de rendez-vous",
            "expression": "DIVIDE([Nombre rendez-vous réalisés],[Nombre rendez-vous prévus],0)",
            "formatString": "0.0%",
            "displayFolder": "02. Rendez-vous",
            "lineageTag": "00e833f8-e1dc-4096-a965-75b6d4ee1fe9"
          },
          {
            "name": "Nombre mandataires actifs",
            "expression": "VAR MandatairesAgence =\n    CALCULATETABLE(\n        VALUES(fact_affectation_mandataire[mandataire_id]),\n        TREATAS(VALUES(dim_agence[agence_id]), fact_affectation_mandataire[agence_id])\n    )\nRETURN\nCOALESCE(\n    CALCULATE(\n        DISTINCTCOUNT(dim_mandataire[mandataire_id]),\n        dim_mandataire[statut_mandataire] = \"Actif\",\n        TREATAS(MandatairesAgence, dim_mandataire[mandataire_id])\n    ),\n    0\n)",
            "displayFolder": "03. Réseau MIA",
            "lineageTag": "a74c07da-3566-4e43-95a6-dbe9a4ff73fd",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "formatString": "0"
          },
          {
            "name": "Nombre mandataires inactifs",
            "expression": "VAR MandatairesAgence =\n    CALCULATETABLE(\n        VALUES(fact_affectation_mandataire[mandataire_id]),\n        TREATAS(VALUES(dim_agence[agence_id]), fact_affectation_mandataire[agence_id])\n    )\nRETURN\nCOALESCE(\n    CALCULATE(\n        DISTINCTCOUNT(dim_mandataire[mandataire_id]),\n        dim_mandataire[statut_mandataire] = \"Inactif\",\n        TREATAS(MandatairesAgence, dim_mandataire[mandataire_id])\n    ),\n    0\n)",
            "formatString": "0",
            "displayFolder": "03. Réseau MIA",
            "lineageTag": "7d7cc140-2dbd-484c-a4cc-d408bf56636c"
          },
          {
            "name": "Nombre entretiens réalisés",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT( fact_parcours_candidat[candidat_id] ),",
              "    fact_parcours_candidat[etape_parcours_id] = \"Rendez-vous Suivi\"",
              ")"
            ],
            "displayFolder": "Développement Réseau",
            "lineageTag": "27d8c737-5abf-4143-a86a-d27c578c3224",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "isHidden": true
          },
          {
            "name": "Nombre journées découverte réalisées",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT( fact_parcours_candidat[candidat_id] ),",
              "    fact_parcours_candidat[etape_parcours_id] = \"Journée découverte\"",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "Développement Réseau",
            "lineageTag": "dd2cf03b-bd5c-4fe4-b9e5-755dcd717c39",
            "isHidden": true
          },
          {
            "name": "Nombre inscrits formation initiale",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT(fact_parcours_candidat[candidat_id]),",
              "    fact_parcours_candidat[etape_parcours_id] = \"Inscrit Formation\"",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "Développement Réseau",
            "lineageTag": "41e65574-72ed-4ba2-8820-1119f5a2bcaf",
            "isHidden": true
          },
          {
            "name": "Nombre mandataires ayant passé l'examen",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT( fact_parcours_candidat[candidat_id] ),",
              "    fact_parcours_candidat[score_examen] > 0",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "Développement Réseau",
            "lineageTag": "3f4202fe-c4ee-4423-93b0-93f81ee5d71f",
            "isHidden": true
          },
          {
            "name": "Nombre mandataires ayant réussi l'examen",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT( fact_parcours_candidat[candidat_id] ),",
              "    fact_parcours_candidat[score_examen] > 50",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "Développement Réseau",
            "lineageTag": "baf15877-ef57-461f-8177-0a83234839ef",
            "isHidden": true
          },
          {
            "name": "Année présence mandataire dans le groupe",
            "expression": [
              "",
              "VAR DateEntreeMin =",
              "    CALCULATE(",
              "        MIN ( fact_affectation_mandataire[date_entree] ),",
              "        ALLEXCEPT(",
              "            fact_affectation_mandataire,",
              "            fact_affectation_mandataire[mandataire_id]",
              "        )",
              "    )",
              "",
              "VAR DateReference =",
              "    MAX ( dim_date[Date] )",
              "",
              "RETURN",
              "IF(",
              "    NOT ISBLANK ( DateEntreeMin ) && NOT ISBLANK ( DateReference ),",
              "    DATEDIFF( DateEntreeMin, DateReference, YEAR )",
              ")",
              ""
            ],
            "formatString": "0",
            "displayFolder": "Développement Réseau",
            "lineageTag": "f1293a55-cf04-4efd-a64a-e689c478df02",
            "isHidden": true
          },
          {
            "name": "Année présence mandataire dans agence",
            "expression": [
              "",
              "VAR DateEntreeMin =",
              "    CALCULATE(",
              "        MIN( 'fact_affectation_mandataire'[date_entree] ),",
              "        ALLEXCEPT(",
              "            'fact_affectation_mandataire',",
              "            'fact_affectation_mandataire'[mandataire_id],",
              "            'fact_affectation_mandataire'[agence_id]",
              "        )",
              "    )",
              " ",
              "-- Date de référence = fin de l'année sélectionnée (ou TODAY() si aucun filtre)",
              "VAR AnneeSelectionnee =",
              "    SELECTEDVALUE( dim_date[annee])",
              " ",
              "VAR DateReference =",
              "    IF(",
              "        NOT ISBLANK( AnneeSelectionnee ),",
              "        DATE( AnneeSelectionnee, 12, 31 ),",
              "        TODAY()",
              "    )",
              " VAR agenceSelectionne =",
              "    SELECTEDVALUE (dim_agence[raison_sociale])",
              "    ",
              "RETURN",
              "IF(",
              "    NOT ISBLANK( DateEntreeMin ),",
              "    DATEDIFF( DateEntreeMin, DateReference, YEAR )",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "Développement Réseau",
            "lineageTag": "cf333a45-5b4b-44fc-97d9-04b543b68dbf",
            "isHidden": true
          },
          {
            "name": "Nombre mandataires rétrocommissionnés",
            "expression": "VAR MandatairesAgence =\n    CALCULATETABLE(\n        VALUES(fact_affectation_mandataire[mandataire_id]),\n        TREATAS(VALUES(dim_agence[agence_id]), fact_affectation_mandataire[agence_id])\n    )\nVAR MandatairesContexte =\n    INTERSECT(\n        VALUES(dim_mandataire[mandataire_id]),\n        MandatairesAgence\n    )\nRETURN\nCOUNTROWS(\n    FILTER(\n        MandatairesContexte,\n        VAR CurrentMandataire = dim_mandataire[mandataire_id]\n        VAR RdvMandataire =\n            CALCULATETABLE(\n                VALUES(bridge_rendez_vous_mandataire[rendez_vous_id]),\n                bridge_rendez_vous_mandataire[mandataire_id] = CurrentMandataire\n            )\n        VAR Commission =\n            CALCULATE(\n                SUM(fact_rendez_vous_client[commission_realise]),\n                TREATAS(RdvMandataire, fact_rendez_vous_client[rendez_vous_id])\n            )\n        RETURN Commission > 0\n    )\n)",
            "formatString": "0",
            "displayFolder": "03. Réseau MIA",
            "lineageTag": "9b648af1-f1c6-4f2a-a4ae-ba5b5b59498a"
          },
          {
            "name": "Montant moyen de rétrocommission",
            "expression": "COALESCE(AVERAGE(fact_rendez_vous_client[commission_realise]), 0)",
            "formatString": "#,0 €",
            "displayFolder": "03. Réseau MIA",
            "lineageTag": "a360af64-734e-468d-8db5-2a7d47ae50a5",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Moyenne Taux Réalisation de rendez-vous",
            "expression": [
              "",
              "AVERAGEX(",
              "    VALUES ( dim_mandataire[mandataire_id] ),",
              "    [Taux réalisation de rendez-vous]",
              ")"
            ],
            "displayFolder": "Pilotage Commercial - Analytique",
            "lineageTag": "f5a48a34-fd79-469d-afa2-e6159dd87021",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Ecart Taux Réalisation",
            "expression": [
              "",
              "DIVIDE([Taux réalisation de rendez-vous] - [Moyenne Taux Réalisation de rendez-vous],[Moyenne Taux Réalisation de rendez-vous],0)",
              ""
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "Pilotage Commercial - Analytique",
            "lineageTag": "4cc66dc5-adb6-4be9-be82-66e4d4ea2836"
          },
          {
            "name": "Couleur Ecart Taux Réalisation",
            "expression": [
              "",
              "IF(",
              "    [Ecart Taux Réalisation] > 0,",
              "    \"#C49669\",   -- vert",
              "    IF(",
              "        [Ecart Taux Réalisation] < 0,",
              "        \"#000000\", -- rouge",
              "        \"#666666\"  -- gris neutre",
              "    )",
              ")"
            ],
            "displayFolder": "Pilotage Commercial - Analytique",
            "lineageTag": "c7247f50-d351-4033-8aee-eaeea6049967"
          },
          {
            "name": "Moyenne année présence mandataire dans le groupe",
            "expression": [
              "",
              "AVERAGEX(",
              "    VALUES('fact_affectation_mandataire'[mandataire_id]),",
              "    [Année présence mandataire dans le groupe]",
              ")"
            ],
            "displayFolder": "Développement Réseau",
            "lineageTag": "515842b2-7e91-4c72-a503-452bac3b6976",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "isHidden": true
          },
          {
            "name": "Nombre candidats",
            "expression": "DISTINCTCOUNT(fact_parcours_candidat[candidat_id])",
            "formatString": "0",
            "displayFolder": "Développement Réseau",
            "lineageTag": "5281ae76-c1be-455f-a237-ff2429906d44",
            "isHidden": true
          },
          {
            "name": "Nombre candidats intégrés",
            "expression": [
              "CALCULATE(",
              "    DISTINCTCOUNT( fact_parcours_candidat[candidat_id] ),",
              "    fact_parcours_candidat[score_examen] > 50",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "Développement Réseau",
            "lineageTag": "eb4cfb39-202c-4921-8039-91656e0fac3d",
            "isHidden": true
          },
          {
            "name": "Taux intégration candidats",
            "expression": [
              "",
              "DIVIDE(",
              "    [Nombre candidats intégrés],",
              "    [Nombre candidats],",
              "    0",
              ")"
            ],
            "displayFolder": "Développement Réseau",
            "lineageTag": "ba777612-1fc3-491e-8455-c9d7ff974edd",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "isHidden": true
          },
          {
            "name": "Moyenne age candidats",
            "expression": [
              "",
              "COALESCE(",
              "    AVERAGEX(",
              "        FILTER(",
              "            'dim_candidat',",
              "            NOT ISBLANK('dim_candidat'[age])",
              "                && 'dim_candidat'[age] >= 0",
              "        ),",
              "        'dim_candidat'[age]",
              "    ),",
              "    0",
              ")"
            ],
            "displayFolder": "Développement Réseau",
            "lineageTag": "278732dd-ce67-4873-9789-388a6ea1c5a7",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "isHidden": true
          },
          {
            "name": "Taux de succès à l'examen (%)",
            "expression": [
              "",
              "DIVIDE(",
              "    [Nombre mandataires ayant réussi l'examen],",
              "    [Nombre mandataires ayant passé l'examen]",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "Développement Réseau",
            "lineageTag": "8be560d9-7bbf-40cd-9eea-8908e794936e",
            "isHidden": true
          },
          {
            "name": "Nombre rendez-vous réalisés en visioconférence",
            "expression": [
              "",
              "CALCULATE(",
              "    COUNT(bridge_rendez_vous_mandataire[rendez_vous_id]),",
              "    'fact_rendez_vous_client'[flag_rendez_vous_realise] = TRUE(),",
              "    'fact_rendez_vous_client'[flag_visio] = TRUE()",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "02. Rendez-vous",
            "lineageTag": "4a0c1d29-4183-454f-8dbf-30f4e5274de5"
          },
          {
            "name": "Nombre rendez-vous réalisés à domicile",
            "expression": [
              "",
              "CALCULATE(",
              "    COUNT(bridge_rendez_vous_mandataire[rendez_vous_id]),",
              "    'fact_rendez_vous_client'[flag_rendez_vous_realise] = TRUE(),",
              "    'fact_rendez_vous_client'[flag_visio] = FALSE()",
              ")",
              ""
            ],
            "formatString": "0",
            "displayFolder": "02. Rendez-vous",
            "lineageTag": "dd8f6759-9e88-4ce5-9c31-2b051360a91a"
          },
          {
            "name": "Taux rendez vous réalisés en visioconférence",
            "expression": [
              "",
              "DIVIDE(",
              "    [Nombre rendez-vous réalisés en visioconférence],",
              "    [Nombre rendez-vous réalisés],",
              "    0",
              ")"
            ],
            "displayFolder": "Pilotage Commercial",
            "lineageTag": "da326aa4-ab42-4e7d-a469-4db908d8735a",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Taux rendez-vous faits à domicile",
            "expression": [
              "",
              "",
              "DIVIDE(",
              "    [Nombre rendez-vous réalisés à domicile],",
              "    [Nombre rendez-vous réalisés],",
              "    0",
              ")"
            ],
            "displayFolder": "Pilotage Commercial",
            "lineageTag": "3f7608ee-e27a-4c1b-9a4c-45e73e91d42e",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Nombre RDV prévus (par type mandataire)",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT ( bridge_rendez_vous_mandataire[rendez_vous_id] ),",
              "    bridge_rendez_vous_mandataire[mandataire_id] <> \"\"",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "Pilotage Commercial - Analytique",
            "lineageTag": "0e9467c6-73a2-4608-939a-8f72a0d06a84"
          },
          {
            "name": "Nombre RDV réalisés (par type mandataire)",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT ( bridge_rendez_vous_mandataire[rendez_vous_id] ),",
              "    bridge_rendez_vous_mandataire[mandataire_id] <> \"\",",
              "    fact_rendez_vous_client[flag_rendez_vous_realise] = TRUE()",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "Pilotage Commercial - Analytique",
            "lineageTag": "1593dbbc-562a-4a8e-8781-bc0f01e0a1d7"
          },
          {
            "name": "Taux réalisation RDV (par type mandataire)",
            "expression": [
              "",
              "DIVIDE(",
              "    [Nombre RDV réalisés (par type mandataire)],",
              "    [Nombre RDV prévus (par type mandataire)]",
              ")"
            ],
            "displayFolder": "Pilotage Commercial - Analytique",
            "lineageTag": "1ba2835e-e887-4358-872c-5be219075d03",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Nombre RDV prévus (agence)",
            "expression": [
              "",
              "VAR AgenceCourante =",
              "    SELECTEDVALUE ( dim_agence[agence_id] )",
              "RETURN",
              "CALCULATE (",
              "    DISTINCTCOUNT ( fact_rendez_vous_client[rendez_vous_id] ),",
              "    FILTER (",
              "        bridge_rendez_vous_mandataire,",
              "        bridge_rendez_vous_mandataire[role_mandataire] = \"PRINCIPAL\"",
              "            && bridge_rendez_vous_mandataire[mandataire_id] <> \"\"",
              "    ),",
              "    FILTER (",
              "        fact_affectation_mandataire,",
              "        fact_affectation_mandataire[agence_id] = AgenceCourante",
              "            && fact_affectation_mandataire[date_entree]",
              "                <= MAX ( fact_rendez_vous_client[date_rendez_vous_client] )",
              "            && (",
              "                ISBLANK ( fact_affectation_mandataire[date_sortie] )",
              "                || fact_affectation_mandataire[date_sortie]",
              "                    >= MIN ( fact_rendez_vous_client[date_rendez_vous_client] )",
              "            )",
              "    )",
              ")",
              ""
            ],
            "formatString": "0",
            "displayFolder": "Pilotage Commercial - Analytique",
            "lineageTag": "991ab623-e24e-4679-9e27-7a5e7bebf26b"
          },
          {
            "name": "Nombre RDV réalisés (agence)",
            "expression": [
              "",
              "VAR AgenceCourante =",
              "    SELECTEDVALUE ( dim_agence[agence_id] )",
              "RETURN",
              "CALCULATE (",
              "    DISTINCTCOUNT ( fact_rendez_vous_client[rendez_vous_id] ),",
              "    fact_rendez_vous_client[flag_rendez_vous_realise] = TRUE(),",
              "    FILTER (",
              "        bridge_rendez_vous_mandataire,",
              "        bridge_rendez_vous_mandataire[role_mandataire] = \"PRINCIPAL\"",
              "            && bridge_rendez_vous_mandataire[mandataire_id] <> \"\"",
              "    ),",
              "    FILTER (",
              "        fact_affectation_mandataire,",
              "        fact_affectation_mandataire[agence_id] = AgenceCourante",
              "            && fact_affectation_mandataire[date_entree]",
              "                <= MAX ( fact_rendez_vous_client[date_rendez_vous_client] )",
              "            && (",
              "                ISBLANK ( fact_affectation_mandataire[date_sortie] )",
              "                || fact_affectation_mandataire[date_sortie]",
              "                    >= MIN ( fact_rendez_vous_client[date_rendez_vous_client] )",
              "            )",
              "    )",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "Pilotage Commercial - Analytique",
            "lineageTag": "aa9939dd-d6f0-4ad9-90c4-725979984cf9"
          },
          {
            "name": "Nombre mandataires rétrocommissionnés N-1",
            "expression": [
              "",
              "CALCULATE (",
              "    [Nombre mandataires rétrocommissionnés],",
              "    SAMEPERIODLASTYEAR ( dim_date[Date] )",
              ")",
              "    "
            ],
            "formatString": "0",
            "displayFolder": "Pilotage Commercial - Analytique",
            "lineageTag": "ba468911-e26a-4a57-8bd5-5a69afcbaa41"
          },
          {
            "name": "Évolution mandataires rétro vs N-1 (%)",
            "expression": [
              "",
              "VAR N = [Nombre mandataires rétrocommissionnés]",
              "VAR N_1 = [Nombre mandataires rétrocommissionnés N-1]",
              "RETURN",
              "IF (",
              "    NOT ISBLANK ( N_1 ),",
              "    DIVIDE ( N - N_1, N_1 )",
              ")"
            ],
            "displayFolder": "Pilotage Commercial - Analytique",
            "lineageTag": "9d9fddbf-05d2-44cf-8596-9946474777f7",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Montant rétrocommission",
            "expression": "VAR RdvContexte =\n    CALCULATETABLE(\n        VALUES(bridge_rendez_vous_mandataire[rendez_vous_id]),\n        TREATAS(VALUES(dim_mandataire[mandataire_id]), bridge_rendez_vous_mandataire[mandataire_id])\n    )\nRETURN\nCOALESCE(\n    CALCULATE(\n        SUM(fact_rendez_vous_client[commission_realise]),\n        TREATAS(RdvContexte, fact_rendez_vous_client[rendez_vous_id])\n    ),\n    0\n)",
            "formatString": "#,0 €",
            "displayFolder": "03. Réseau MIA",
            "lineageTag": "3054123f-0e2a-440c-ad88-fc6ff3deb340"
          },
          {
            "name": "Nombre MIA oriasés",
            "expression": "VAR MandatairesAgence =\n    CALCULATETABLE(\n        VALUES(fact_affectation_mandataire[mandataire_id]),\n        TREATAS(VALUES(dim_agence[agence_id]), fact_affectation_mandataire[agence_id])\n    )\nRETURN\nCOALESCE(\n    CALCULATE(\n        DISTINCTCOUNT(dim_mandataire[mandataire_id]),\n        NOT ISBLANK(dim_mandataire[date_passage_mia]),\n        TREATAS(MandatairesAgence, dim_mandataire[mandataire_id])\n    ),\n    0\n)",
            "displayFolder": "03. Réseau MIA",
            "lineageTag": "98ea827c-b5d1-4608-b033-c5c0c7af72b3",
            "formatString": "0",
            "description": "KPI non disponible : colonne dim_mandataire[numero_orias] absente du modèle de base."
          },
          {
            "name": "Nombre mandataires non rétrocommissionnés",
            "expression": "MAX([Nombre mandataires actifs] - [Nombre mandataires rétrocommissionnés], 0)",
            "displayFolder": "03. Réseau MIA",
            "lineageTag": "99090dc1-7fd2-4f12-b9c8-deedf8d02c1a",
            "formatString": "0"
          },
          {
            "name": "Taux mandataires actifs",
            "expression": "DIVIDE([Nombre mandataires actifs], [Nombre mandataires actifs] + [Nombre mandataires inactifs], 0)",
            "displayFolder": "Pilotage Commercial - Réseau",
            "lineageTag": "dffe1a9f-6b75-47c3-9fbf-b36cb9f1d2eb",
            "formatString": "0.0%"
          },
          {
            "name": "Nombre RDV hebdomadaire moyen",
            "expression": "DIVIDE([Nombre rendez-vous réalisés], DISTINCTCOUNT(dim_date[numero_de_la_semaine]), 0)",
            "displayFolder": "Pilotage Commercial - RDV",
            "lineageTag": "118ce158-db31-4369-bd3c-cb8a64275288",
            "formatString": "#,0.0"
          },
          {
            "name": "Niveau Alerte Volume",
            "expression": "VAR VarPct = [Variation vs N-1 Volume Affaires (%)]\nRETURN SWITCH(TRUE(),\n    ISBLANK(VarPct), \"NON DISPONIBLE\",\n    VarPct < -0.20, \"CRITIQUE\",\n    VarPct < -0.10, \"HAUTE\",\n    VarPct < 0, \"MOYENNE\",\n    \"CONFORME\")",
            "lineageTag": "Niveau Alerte Volume"
          },
          {
            "name": "Couleur Alerte Volume",
            "expression": "SWITCH([Niveau Alerte Volume],\n    \"CRITIQUE\", \"#D71920\",\n    \"HAUTE\", \"#E67E22\",\n    \"MOYENNE\", \"#F1C40F\",\n    \"CONFORME\", \"#198754\",\n    \"#667085\")",
            "lineageTag": "Couleur Alerte Volume"
          },
          {
            "name": "Niveau Alerte RDV",
            "expression": "VAR Taux = [Taux réalisation de rendez-vous]\nRETURN SWITCH(TRUE(),\n    ISBLANK(Taux), \"NON DISPONIBLE\",\n    Taux < 0.50, \"CRITIQUE\",\n    Taux < 0.70, \"HAUTE\",\n    Taux < 0.85, \"MOYENNE\",\n    \"CONFORME\")",
            "displayFolder": "Pilotage Commercial - Alertes",
            "lineageTag": "9edee728-292e-4fa5-8148-701be3596e6c"
          },
          {
            "name": "Couleur Alerte RDV",
            "expression": "SWITCH([Niveau Alerte RDV],\n    \"CRITIQUE\", \"#D71920\",\n    \"HAUTE\", \"#E67E22\",\n    \"MOYENNE\", \"#F1C40F\",\n    \"CONFORME\", \"#198754\",\n    \"#667085\")",
            "displayFolder": "Pilotage Commercial - Alertes",
            "lineageTag": "d1285acf-73c6-455d-87b4-7b87bba0c0ca"
          },
          {
            "name": "Niveau Alerte Réseau",
            "expression": "VAR Taux = [Taux mandataires actifs]\nRETURN SWITCH(TRUE(),\n    ISBLANK(Taux), \"NON DISPONIBLE\",\n    Taux < 0.60, \"CRITIQUE\",\n    Taux < 0.80, \"HAUTE\",\n    Taux < 0.90, \"MOYENNE\",\n    \"CONFORME\")",
            "displayFolder": "Pilotage Commercial - Alertes",
            "lineageTag": "ac11cdd1-d55d-44fb-ab3c-5178d86b8b5e"
          },
          {
            "name": "Couleur Alerte Réseau",
            "expression": "SWITCH([Niveau Alerte Réseau],\n    \"CRITIQUE\", \"#D71920\",\n    \"HAUTE\", \"#E67E22\",\n    \"MOYENNE\", \"#F1C40F\",\n    \"CONFORME\", \"#198754\",\n    \"#667085\")",
            "displayFolder": "Pilotage Commercial - Alertes",
            "lineageTag": "a62dc7af-60e9-426c-8d4d-862d7e37edc1"
          },
          {
            "name": "Nombre RDV confirmés",
            "lineageTag": "d71f5fd2-4729-460c-af39-54e3338be216",
            "displayFolder": "Pilotage Commercial - RDV",
            "description": "G.16 — RDV confirmés : proxy parent_rendez_vous_id non vide (RDV re-planifié/confirmé). Nécessite une colonne flag_confirme dans fact_rendez_vous_client pour une valeur précise.",
            "expression": [
              "// G.16 — proxy : RDV ayant un parent_rendez_vous_id (re-planifié / confirmé par le client)",
              "// À remplacer par flag_confirme quand la colonne est disponible dans le Lakehouse",
              "CALCULATE(",
              "    DISTINCTCOUNT(bridge_rendez_vous_mandataire[rendez_vous_id]),",
              "    NOT ISBLANK(fact_rendez_vous_client[parent_rendez_vous_id])",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Taux RDV confirmés",
            "lineageTag": "ea5c7075-45ce-40d5-8d9a-bedd49e89e49",
            "displayFolder": "Pilotage Commercial - RDV",
            "description": "G.17 — Taux RDV confirmés / RDV prévus. Dépend de G.16.",
            "expression": [
              "// G.17 — DIVIDE G.16 / G.14",
              "DIVIDE([Nombre RDV confirmés], [Nombre rendez-vous prévus], 0)"
            ],
            "formatString": "0.0%"
          },
          {
            "name": "Priorité Alerte Maximale",
            "expression": "VAR rdv    = SWITCH([Niveau Alerte RDV],    \"CRITIQUE\", 3, \"HAUTE\", 2, \"MOYENNE\", 1, 0)\nVAR volume = SWITCH([Niveau Alerte Volume], \"CRITIQUE\", 3, \"HAUTE\", 2, \"MOYENNE\", 1, 0)\nVAR maxS   = MAX(rdv, volume)\nRETURN SWITCH(maxS, 3, \"CRITIQUE\", 2, \"HAUTE\", 1, \"MOYENNE\", \"CONFORME\")",
            "displayFolder": "Pilotage Commercial - Alertes",
            "lineageTag": "a1b2c3d4-0001-0001-0001-000000000001"
          },
          {
            "name": "Recommandation Alerte RDV",
            "expression": "VAR Taux = [Taux réalisation de rendez-vous]\nRETURN SWITCH([Niveau Alerte RDV],\n    \"CRITIQUE\", \"Taux \" & FORMAT(Taux, \"0%\") & \" — relancer immédiatement les RDV non honorés\",\n    \"HAUTE\",    \"Taux \" & FORMAT(Taux, \"0%\") & \" — suivre et accompagner ce mandataire\",\n    \"MOYENNE\",  \"Taux \" & FORMAT(Taux, \"0%\") & \" — encourager la planification des RDV\",\n    BLANK()\n)",
            "displayFolder": "Pilotage Commercial - Alertes",
            "lineageTag": "a1b2c3d4-0002-0002-0002-000000000002"
          },
          {
            "name": "Recommandation Alerte Volume",
            "expression": "VAR Var = [Variation vs N-1 Volume Affaires (%)]\nRETURN SWITCH([Niveau Alerte Volume],\n    \"CRITIQUE\", \"Volume affaires \" & FORMAT(Var, \"0%\") & \" vs N-1 — action commerciale urgente\",\n    \"HAUTE\",    \"Volume affaires \" & FORMAT(Var, \"0%\") & \" vs N-1 — surveiller la tendance\",\n    \"MOYENNE\",  \"Volume affaires légèrement en baisse \" & FORMAT(Var, \"0%\") & \" vs N-1\",\n    BLANK()\n)",
            "lineageTag": "Recommandation Alerte Volume"
          },
          {
            "name": "Nombre ventes",
            "expression": "COALESCE(\n    CALCULATE(\n        DISTINCTCOUNT(fact_affaire[contrat_id]),\n        fact_affaire[flag_pu] = 1\n    ),\n    0\n)",
            "lineageTag": "Nombre ventes",
            "formatString": "#,##0",
            "displayFolder": "Pilotage Commercial - Production"
          },
          {
            "name": "Nombre affaires produites",
            "expression": "COALESCE(CALCULATE(DISTINCTCOUNT(fact_affaire[affaire_id]), fact_affaire[flag_pu] = 1), 0)",
            "lineageTag": "Nombre affaires produites",
            "formatString": "0",
            "displayFolder": "01. Affaires"
          },
          {
            "name": "Volume affaires produites",
            "expression": "COALESCE(CALCULATE(SUM(fact_affaire[chiffre_affaires]), fact_affaire[flag_pu] = 1), 0)",
            "lineageTag": "Volume affaires produites",
            "formatString": "#,0 €",
            "displayFolder": "01. Affaires"
          },
          {
            "name": "Nombre affaires en instance",
            "expression": "COALESCE(CALCULATE(DISTINCTCOUNT(fact_affaire[affaire_id]), fact_affaire[flag_pu] = 0), 0)",
            "lineageTag": "Nombre affaires en instance",
            "formatString": "0",
            "displayFolder": "01. Affaires"
          },
          {
            "name": "Volume affaires en instance",
            "expression": "COALESCE(CALCULATE(SUM(fact_affaire[chiffre_affaires]), fact_affaire[flag_pu] = 0), 0)",
            "lineageTag": "Volume affaires en instance",
            "formatString": "#,0 €",
            "displayFolder": "01. Affaires"
          },
          {
            "name": "Nombre affaires commissionnées",
            "expression": "COALESCE(CALCULATE(DISTINCTCOUNT(fact_affaire[affaire_id]), fact_affaire[etat_affaire_id] = \"ETA001\"), 0)",
            "lineageTag": "Nombre affaires commissionnées",
            "formatString": "0",
            "displayFolder": "01. Affaires"
          },
          {
            "name": "Volume affaires commissionnées",
            "expression": "COALESCE(CALCULATE(SUM(fact_affaire[chiffre_affaires]), fact_affaire[etat_affaire_id] = \"ETA001\"), 0)",
            "lineageTag": "Volume affaires commissionnées",
            "formatString": "#,0 €",
            "displayFolder": "01. Affaires"
          },
          {
            "name": "Budget affaires en nombre",
            "expression": "COALESCE(ROUND([Nombre affaires produites] * 1.15, 0), 0)",
            "lineageTag": "Budget affaires en nombre",
            "formatString": "0"
          },
          {
            "name": "Budget affaires en euro",
            "expression": "COALESCE([Volume affaires produites] * 1.15, 0)",
            "lineageTag": "Budget affaires en euro",
            "formatString": "#,0 €",
            "displayFolder": "01. Affaires"
          },
          {
            "name": "Taux atteinte Budget N Volume",
            "expression": "DIVIDE([Volume affaires produites], [Budget affaires en euro], 0)",
            "lineageTag": "Taux atteinte Budget N Volume",
            "formatString": "0.0%",
            "displayFolder": "01. Affaires"
          },
          {
            "name": "Volume affaires produites N-1",
            "expression": "CALCULATE([Volume affaires produites], SAMEPERIODLASTYEAR(dim_date[Date]))",
            "lineageTag": "Volume affaires produites N-1"
          },
          {
            "name": "Variation vs N-1 Volume Affaires (%)",
            "expression": "DIVIDE([Volume affaires produites] - [Volume affaires produites N-1], [Volume affaires produites N-1], 0)",
            "lineageTag": "Variation vs N-1 Volume Affaires (%)"
          },
          {
            "name": "Volume affaires produites MTD-1",
            "expression": "CALCULATE([Volume affaires produites], DATEADD(dim_date[Date], -1, MONTH))",
            "lineageTag": "Volume affaires produites MTD-1"
          },
          {
            "name": "Variation vs MTD-1 Volume Affaires (%)",
            "expression": "DIVIDE([Volume affaires produites] - [Volume affaires produites MTD-1], [Volume affaires produites MTD-1], 0)",
            "lineageTag": "Variation vs MTD-1 Volume Affaires (%)"
          },
          {
            "name": "Nombre mandataires productifs",
            "expression": "COALESCE(\n    CALCULATE(\n        DISTINCTCOUNT(fact_affaire[mandataire_id]),\n        fact_affaire[flag_pu] = 1\n    ),\n    0\n)",
            "lineageTag": "Nombre mandataires productifs",
            "formatString": "#,##0",
            "displayFolder": "Pilotage Commercial - Réseau"
          },
          {
            "name": "Nombre mandataires non productifs",
            "expression": "MAX([Nombre mandataires actifs] - [Nombre mandataires productifs], 0)",
            "lineageTag": "Nombre mandataires non productifs",
            "formatString": "0",
            "displayFolder": "03. Réseau MIA"
          },
          {
            "name": "CF Variation Texte Volume",
            "expression": "SWITCH(TRUE(),\n    ISBLANK([Variation vs N-1 Volume Affaires (%)]), \"#0A4E97\",\n    [Variation vs N-1 Volume Affaires (%)] >= 0, \"#198754\",\n    [Variation vs N-1 Volume Affaires (%)] > -0.10, \"#E67E22\",\n    \"#D71920\")",
            "lineageTag": "CF Variation Texte Volume"
          },
          {
            "name": "CF Budget Fill Volume",
            "expression": "SWITCH(TRUE(),\n    ISBLANK([Taux atteinte Budget N Volume]), \"#E8EEF5\",\n    [Taux atteinte Budget N Volume] >= 1, \"#198754\",\n    [Taux atteinte Budget N Volume] >= 0.8, \"#E67E22\",\n    \"#D71920\")",
            "lineageTag": "CF Budget Fill Volume"
          },
          {
            "name": "Libellé Variation Volume vs N-1",
            "expression": "VAR v = [Variation vs N-1 Volume Affaires (%)]\nRETURN SWITCH(TRUE(),\n    ISBLANK(v), \"Vs N-1 —\",\n    v >= 0, \"▲ Vs N-1 \" & FORMAT(v, \"+0.0%;-0.0%\"),\n    \"▼ Vs N-1 \" & FORMAT(v, \"+0.0%;-0.0%\"))",
            "lineageTag": "Libellé Variation Volume vs N-1"
          },
          {
            "name": "Libellé Variation Volume vs MTD-1",
            "expression": "VAR v = [Variation vs MTD-1 Volume Affaires (%)]\nRETURN SWITCH(TRUE(),\n    ISBLANK(v), \"Vs MTD-1 —\",\n    v >= 0, \"▲ Vs MTD-1 \" & FORMAT(v, \"+0.0%;-0.0%\"),\n    \"▼ Vs MTD-1 \" & FORMAT(v, \"+0.0%;-0.0%\"))",
            "lineageTag": "Libellé Variation Volume vs MTD-1"
          },
          {
            "name": "Recommandation Volume",
            "expression": "VAR VarPct = [Variation vs N-1 Volume Affaires (%)]\nRETURN SWITCH(TRUE(),\n    ISBLANK(VarPct), \"Données volume affaires indisponibles.\",\n    VarPct < -0.10, \"Identifier les agences en recul et déclencher un plan de relance.\",\n    VarPct < 0, \"Surveiller la trajectoire et challenger les zones en retrait.\",\n    \"Sécuriser l'atterrissage.\")",
            "lineageTag": "Recommandation Volume"
          },
          {
            "name": "CF Fond Tile Taux RDV",
            "expression": [
              "",
              "SWITCH(TRUE(),",
              "    ISBLANK([Taux réalisation de rendez-vous]), \"#FFFFFF\",",
              "    [Taux réalisation de rendez-vous] >= 0.62, \"#D1FAE5\",",
              "    [Taux réalisation de rendez-vous] >= 0.40, \"#FEF3C7\",",
              "    \"#FEE2E2\"",
              ")"
            ],
            "formatString": ""
          },
          {
            "name": "CF Valeur Taux RDV",
            "expression": [
              "",
              "SWITCH(TRUE(),",
              "    ISBLANK([Taux réalisation de rendez-vous]), \"#051E73\",",
              "    [Taux réalisation de rendez-vous] >= 0.62, \"#00B050\",",
              "    [Taux réalisation de rendez-vous] >= 0.40, \"#D97706\",",
              "    \"#F05062\"",
              ")"
            ],
            "formatString": ""
          },
          {
            "name": "CF Fond Taux Budget",
            "expression": [
              "",
              "SWITCH(TRUE(),",
              "    ISBLANK([Taux atteinte Budget N Volume]), \"#FFFFFF\",",
              "    [Taux atteinte Budget N Volume] >= 1, \"#D1FAE5\",",
              "    [Taux atteinte Budget N Volume] >= 0.8, \"#FEF3C7\",",
              "    \"#FEE2E2\"",
              ")"
            ],
            "formatString": ""
          },
          {
            "name": "Nb Domaines Critiques",
            "expression": [
              "VAR v = IF([Niveau Alerte Volume] = \"CRITIQUE\", 1, 0)",
              "VAR r = IF([Niveau Alerte RDV]    = \"CRITIQUE\", 1, 0)",
              "VAR n = IF([Niveau Alerte Réseau] = \"CRITIQUE\", 1, 0)",
              "RETURN v + r + n"
            ],
            "formatString": "0"
          },
          {
            "name": "Nb Domaines Hautes",
            "expression": [
              "VAR v = IF([Niveau Alerte Volume] = \"HAUTE\", 1, 0)",
              "VAR r = IF([Niveau Alerte RDV]    = \"HAUTE\", 1, 0)",
              "VAR n = IF([Niveau Alerte Réseau] = \"HAUTE\", 1, 0)",
              "RETURN v + r + n"
            ],
            "formatString": "0"
          },
          {
            "name": "Nb Domaines Moyennes",
            "expression": [
              "VAR v = IF([Niveau Alerte Volume] = \"MOYENNE\", 1, 0)",
              "VAR r = IF([Niveau Alerte RDV]    = \"MOYENNE\", 1, 0)",
              "VAR n = IF([Niveau Alerte Réseau] = \"MOYENNE\", 1, 0)",
              "RETURN v + r + n"
            ],
            "formatString": "0"
          },
          {
            "name": "Nb Domaines Conformes",
            "expression": [
              "VAR v = IF([Niveau Alerte Volume] = \"CONFORME\", 1, 0)",
              "VAR r = IF([Niveau Alerte RDV]    = \"CONFORME\", 1, 0)",
              "VAR n = IF([Niveau Alerte Réseau] = \"CONFORME\", 1, 0)",
              "RETURN v + r + n"
            ],
            "formatString": "0"
          },
          {
            "name": "Nb Alertes DAX Total",
            "expression": "[Nb Domaines Critiques] + [Nb Domaines Hautes] + [Nb Domaines Moyennes]",
            "formatString": "0"
          },
          {
            "name": "CF Fond KPI Critique",
            "expression": "IF([Nb Domaines Critiques] > 0, \"#FEE2E2\", \"#FFFFFF\")"
          },
          {
            "name": "CF Fond KPI Haute",
            "expression": "IF([Nb Domaines Hautes] > 0, \"#FEF3C7\", \"#FFFFFF\")"
          },
          {
            "name": "CF Fond KPI Moyenne",
            "expression": "IF([Nb Domaines Moyennes] > 0, \"#FEFCE8\", \"#FFFFFF\")"
          },
          {
            "name": "CF Fond KPI Conforme",
            "expression": "IF([Nb Domaines Conformes] > 0, \"#D1FAE5\", \"#FFFFFF\")"
          },
          {
            "name": "CF Fond Alerte Volume",
            "expression": [
              "SWITCH([Niveau Alerte Volume],",
              "    \"CRITIQUE\", \"#FEE2E2\",",
              "    \"HAUTE\",    \"#FEF3C7\",",
              "    \"MOYENNE\",  \"#FEFCE8\",",
              "    \"CONFORME\", \"#D1FAE5\",",
              "    \"#F6F7FB\")"
            ],
            "displayFolder": "Pilotage Commercial - Alertes"
          },
          {
            "name": "CF Fond Alerte RDV",
            "expression": [
              "SWITCH([Niveau Alerte RDV],",
              "    \"CRITIQUE\", \"#FEE2E2\",",
              "    \"HAUTE\",    \"#FEF3C7\",",
              "    \"MOYENNE\",  \"#FEFCE8\",",
              "    \"CONFORME\", \"#D1FAE5\",",
              "    \"#F6F7FB\")"
            ],
            "displayFolder": "Pilotage Commercial - Alertes"
          },
          {
            "name": "CF Fond Alerte Réseau",
            "expression": [
              "SWITCH([Niveau Alerte Réseau],",
              "    \"CRITIQUE\", \"#FEE2E2\",",
              "    \"HAUTE\",    \"#FEF3C7\",",
              "    \"MOYENNE\",  \"#FEFCE8\",",
              "    \"CONFORME\", \"#D1FAE5\",",
              "    \"#F6F7FB\")"
            ],
            "displayFolder": "Pilotage Commercial - Alertes"
          },
          {
            "name": "Dernière MAJ",
            "expression": "FORMAT(NOW(), \"DD/MM/YYYY\")",
            "displayFolder": "00. Navigation"
          },
          {
            "name": "Libellé Budget Volume",
            "expression": [
              "IF(",
              "    ISBLANK([Budget affaires en euro]),",
              "    \"Budget — en attente\",",
              "    \"Budget N · \" & FORMAT([Budget affaires en euro], \"#,0 €\")",
              ")"
            ],
            "displayFolder": "01. Affaires"
          },
          {
            "name": "Mois Comparaison Sélectionné",
            "expression": "COALESCE(SELECTEDVALUE(Mois_Compare[Mois]), \"— aucun —\")",
            "displayFolder": "00. Navigation"
          },
          {
            "name": "Mois Référence Sélectionné",
            "expression": "COALESCE(SELECTEDVALUE(Mois_Reference[Mois]), \"— aucun —\")",
            "displayFolder": "00. Navigation"
          },
          {
            "name": "Libellé Comparaison",
            "expression": [
              "VAR ref = COALESCE(SELECTEDVALUE(Mois_Reference[Mois]), \"réf. non sélectionné\")",
              "VAR cmp = COALESCE(SELECTEDVALUE(Mois_Compare[Mois]),   \"cmp. non sélectionné\")",
              "RETURN \"🗓 \" & ref & \"  ↔  \" & cmp"
            ],
            "displayFolder": "00. Navigation"
          },
          {
            "name": "Volume Mois Référence",
            "expression": "CALCULATE([Volume affaires produites], TREATAS(VALUES(Mois_Reference[Date]), dim_date[Date]))",
            "formatString": "#,##0",
            "displayFolder": "Pilotage Commercial - Comparaison"
          },
          {
            "name": "Volume Mois Comparé",
            "expression": "CALCULATE([Volume affaires produites], TREATAS(VALUES(Mois_Compare[Date]), dim_date[Date]))",
            "formatString": "#,##0",
            "displayFolder": "Pilotage Commercial - Comparaison"
          },
          {
            "name": "Écart Volume Mois",
            "expression": "[Volume Mois Référence] - [Volume Mois Comparé]",
            "formatString": "+#,##0;-#,##0;0",
            "displayFolder": "Pilotage Commercial - Comparaison"
          },
          {
            "name": "Écart % Volume Mois",
            "expression": "DIVIDE([Volume Mois Référence] - [Volume Mois Comparé], [Volume Mois Comparé], 0)",
            "formatString": "+0.0%;-0.0%;0%",
            "displayFolder": "Pilotage Commercial - Comparaison"
          },
          {
            "name": "Collecte Mois Référence",
            "expression": "CALCULATE([Montant collecte], TREATAS(VALUES(Mois_Reference[Date]), dim_date[Date]))",
            "formatString": "€#,##0",
            "displayFolder": "Pilotage Commercial - Comparaison"
          },
          {
            "name": "Collecte Mois Comparé",
            "expression": "CALCULATE([Montant collecte], TREATAS(VALUES(Mois_Compare[Date]), dim_date[Date]))",
            "formatString": "€#,##0",
            "displayFolder": "Pilotage Commercial - Comparaison"
          },
          {
            "name": "Écart Collecte Mois",
            "expression": "[Collecte Mois Référence] - [Collecte Mois Comparé]",
            "formatString": "+€#,##0;-€#,##0;€0",
            "displayFolder": "Pilotage Commercial - Comparaison"
          },
          {
            "name": "Écart % Collecte Mois",
            "expression": "DIVIDE([Collecte Mois Référence] - [Collecte Mois Comparé], [Collecte Mois Comparé], 0)",
            "formatString": "+0.0%;-0.0%;0%",
            "displayFolder": "Pilotage Commercial - Comparaison"
          }
        ],
        "annotations": [
          {
            "name": "PBI_Id",
            "value": "37cc82f1df8e40a6b05b11fa14f58f8f"
          },
          {
            "name": "436ba87b-9c83-4389-a31b-ebd06a36be98",
            "value": "{\"Expression\":\"\"}"
          }
        ]
      },
