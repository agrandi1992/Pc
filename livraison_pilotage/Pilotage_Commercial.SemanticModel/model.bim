        "partitions": [
          {
            "name": "fact_rendez_vous_client",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Source = #table(\n        type table [rendez_vous_id = text, contact_id = text, parent_rendez_vous_id = text,\n                    type_rendez_vous_id = text, date_pose_rendez_vous = date,\n                    date_rendez_vous_client = date, flag_rendez_vous_realise = logical,\n                    flag_visio = logical, montant_prescrit = number, montant_realise = number,\n                    commission_realise = number, nombre_mandataires_presents = Int64.Type],\n        {\n            {\"RDV001\",\"CLI001\",null,\"TRV001\",#date(2024,1,10),#date(2024,1,15),true, false,45000,45000,2250,1},\n            {\"RDV002\",\"CLI002\",null,\"TRV001\",#date(2024,1,18),#date(2024,1,22),true, true, 12000,12000,600, 1},\n            {\"RDV003\",\"CLI003\",null,\"TRV002\",#date(2024,2,1), #date(2024,2,5), false,false,30000,0,    0,   1},\n            {\"RDV004\",\"CLI004\",null,\"TRV001\",#date(2024,2,15),#date(2024,2,18),true, false,80000,80000,4000,2},\n            {\"RDV005\",\"CLI005\",null,\"TRV002\",#date(2024,3,1), #date(2024,3,3), true, false,25000,25000,1250,1},\n            {\"RDV006\",\"CLI006\",null,\"TRV001\",#date(2024,3,18),#date(2024,3,20),true, true, 18000,18000,900, 1},\n            {\"RDV007\",\"CLI007\",null,\"TRV001\",#date(2024,4,5), #date(2024,4,8), true, false,55000,55000,2750,1},\n            {\"RDV008\",\"CLI008\",null,\"TRV002\",#date(2024,4,22),#date(2024,4,25),false,false,22000,0,    0,   1},\n            {\"RDV009\",\"CLI009\",null,\"TRV001\",#date(2024,5,8), #date(2024,5,12),true, true, 40000,40000,2000,1},\n            {\"RDV010\",\"CLI010\",null,\"TRV001\",#date(2024,5,25),#date(2024,5,28),true, false,15000,15000,750, 1},\n            {\"RDV011\",\"CLI001\",null,\"TRV001\",#date(2024,6,8), #date(2024,6,10),true, false,60000,60000,3000,2},\n            {\"RDV012\",\"CLI002\",null,\"TRV002\",#date(2024,6,22),#date(2024,6,25),false,false,8000, 0,    0,   1},\n            {\"RDV013\",\"CLI003\",null,\"TRV001\",#date(2024,7,10),#date(2024,7,14),true, false,95000,95000,4750,1},\n            {\"RDV014\",\"CLI004\",null,\"TRV001\",#date(2024,7,28),#date(2024,7,30),true, true, 20000,20000,1000,1},\n            {\"RDV015\",\"CLI005\",null,\"TRV001\",#date(2024,8,12),#date(2024,8,16),true, false,35000,35000,1750,1},\n            {\"RDV016\",\"CLI006\",null,\"TRV002\",#date(2024,8,25),#date(2024,8,28),false,false,12000,0,    0,   1},\n            {\"RDV017\",\"CLI007\",null,\"TRV001\",#date(2024,9,3), #date(2024,9,5), true, false,70000,70000,3500,1},\n            {\"RDV018\",\"CLI008\",null,\"TRV001\",#date(2024,9,20),#date(2024,9,22),true, true, 16000,16000,800, 1},\n            {\"RDV019\",\"CLI009\",null,\"TRV001\",#date(2024,10,5),#date(2024,10,8),true, false,28000,28000,1400,2},\n            {\"RDV020\",\"CLI010\",null,\"TRV001\",#date(2024,10,22),#date(2024,10,25),true,false,50000,50000,2500,1}\n        }\n    )\nin Source"
            }
          }
        ],
        "measures": [
          {
            "name": "Flag rétrocommissionné",
            "expression": [
              "",
              "VAR DateContexteMax =",
              "    MAX(dim_date[Date])",
              "VAR DateContexteMin =",
              "    MIN(dim_date[Date])",
              "",
              "VAR NbCommissions =",
              "    CALCULATE(",
              "        COUNTROWS(fact_rendez_vous_client),",
              "        fact_rendez_vous_client[commission_realise] > 0,",
              "        fact_rendez_vous_client[date_rendez_vous_client] >= DateContexteMin,",
              "        fact_rendez_vous_client[date_rendez_vous_client] <= DateContexteMax",
              "    )",
              "",
              "RETURN",
              "IF(NbCommissions > 0, \"Rétrocommissionné\", \"Non rétrocommissionné\")"
            ],
            "lineageTag": "c0b3924b-c8fe-4bd2-848d-4728f657f552",
            "changedProperties": [
              {
                "property": "Name"
              }
            ],
            "displayFolder": "Pilotage Commercial - Réseau",
            "isHidden": true
          }
        ]
      },
