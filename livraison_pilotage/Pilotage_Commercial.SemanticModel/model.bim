              }
            ]
          },
          {
            "name": "flag_connexion",
            "dataType": "int64",
            "sourceColumn": "flag_connexion",
            "formatString": "0",
            "lineageTag": "a57466f4-2491-4243-b7ea-4c8eda8b1059",
            "sourceLineageTag": "flag_connexion",
            "summarizeBy": "sum",
            "annotations": [
              {
