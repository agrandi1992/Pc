        "partitions": [
          {
            "name": "glossaire_indicateurs",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Source = #table(\n        type table [perimetre = text, indicateur = text, definition = text, regle_calcul = text, lecture = text, disponibilite = text, commentaire = text],\n        {\n            {\"Affaires\", \"Nombre d’affaires produites\", \"Total des affaires créées dans le périmètre sur la période.\", \"DistinctCount affaire_id avec flag_pu = 1\", \"Indique le niveau d’activité commerciale brute générée.\", \"Disponible\", \"Inclut les affaires en instance, rejetées et commissionnées.\"},\n            {\"Affaires\", \"Nombre d’affaires commissionnées\", \"Total des affaires dont la première commission a été versée.\", \"DistinctCount affaire_id avec etat_affaire_id = ETA001\", \"Mesure la concrétisation des ventes et la performance en transformation.\", \"Disponible\", \"Hors rétrocommissions détaillées Finance.\"},\n            {\"Affaires\", \"Nombre d’affaires en instance\", \"Total des affaires validées par l’assureur et en cours de décision.\", \"DistinctCount affaire_id avec flag_pu = 0\", \"Reflète le pipeline en attente d’arbitrage.\", \"En attente Prod\", \"Dépend des flux assureurs.\"},\n            {\"Affaires\", \"Volume d’affaires produites (€)\", \"Somme des chiffres d’affaires des affaires créées.\", \"SUM fact_affaire[chiffre_affaires] avec flag_pu = 1\", \"Indique le potentiel de chiffre d’affaires annuel généré.\", \"Disponible\", \"Valeurs annualisées le cas échéant.\"},\n            {\"Finance\", \"Montant de rétrocommission (€)\", \"Montant total des rétrocommissions versées ou à verser.\", \"SUM commission_realise via les RDV liés aux mandataires\", \"Indique le revenu de rétrocession.\", \"En attente Finance\", \"Clôture mensuelle Finance.\"},\n            {\"Réseau\", \"Mandataires actifs\", \"Nombre de mandataires actifs dans le périmètre.\", \"DistinctCount mandataire_id avec statut Actif\", \"Mesure le niveau d’engagement du réseau.\", \"Disponible\", \"Basé sur le statut mandataire et l’affectation agence.\"},\n            {\"Réseau\", \"Mandataires productifs\", \"Nombre de mandataires associés à une production.\", \"Mesure Nombre mandataires productifs\", \"Indique la base productive du réseau.\", \"Disponible\", \"Proxy modèle local.\"},\n            {\"RDV\", \"RDV prévus\", \"Nombre total de rendez-vous planifiés.\", \"DistinctCount rendez_vous_id\", \"Reflète l’activité de prospection planifiée.\", \"Disponible\", \"Tous types de RDV confondus.\"},\n            {\"RDV\", \"RDV réalisés\", \"Nombre total de rendez-vous effectivement réalisés.\", \"RDV avec flag_rendez_vous_realise = true\", \"Indique la capacité d’exécution des RDV planifiés.\", \"Disponible\", \"Statut réalisé par le mandataire.\"},\n            {\"RDV\", \"Taux de réalisation RDV\", \"Part des RDV réalisés par rapport aux RDV prévus.\", \"RDV réalisés / RDV prévus\", \"Évalue la fiabilité de planification et la discipline d’exécution.\", \"Disponible\", \"En %.\"},\n            {\"Qualité\", \"Taux instance\", \"Part des affaires en instance parmi les affaires produites.\", \"Affaires en instance / Affaires produites\", \"Indique le niveau de transformation et la qualité du dossier.\", \"En attente Prod\", \"Dépend des délais assureurs.\"},\n            {\"Qualité\", \"Taux rejet compagnie\", \"Part des affaires rejetées par l’assureur.\", \"Affaires rejetées / Affaires produites\", \"Mesure la qualité du risque et l’adéquation des dossiers.\", \"En attente Prod\", \"Remontée assureurs non consolidée à date.\"}\n        }\n    )\nin Source"
            }
          }
        ]
      },
