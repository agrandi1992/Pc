/* ------------------------------------------------------------
   1. TABLES DÉCONNECTÉES - Période et comparaison de mois
   ------------------------------------------------------------ */

Periode_Affichage =
DATATABLE(
    "Periode", STRING,
    "Ordre", INTEGER,
    {
        {"Jour", 1},
        {"Semaine", 2},
        {"Mois", 3},
        {"Trimestre", 4},
        {"Année", 5}
    }
)

Mois_Reference =
SELECTCOLUMNS(
    'Dim_Date',
    "Mois", 'Dim_Date'[Mois Nom],
    "MoisNum", 'Dim_Date'[Mois Num]
)

Mois_Compare =
SELECTCOLUMNS(
    'Dim_Date',
    "Mois", 'Dim_Date'[Mois Nom],
    "MoisNum", 'Dim_Date'[Mois Num]
)


