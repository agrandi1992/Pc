        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "partitions": [
          {
            "name": "fact_alertes",
            "source": {
              "type": "calculated",
              "expression": [
                "// fact_alertes : table calculée — génère des alertes à partir des conditions KPI Excel",
                "VAR _DateAnalyse = TODAY()",
                "",
                "// Statistiques RDV par mandataire",
                "VAR _Stats =",
                "    ADDCOLUMNS(",
                "        FILTER(",
                "            ALL(dim_mandataire[mandataire_id]),",
                "            CALCULATE(COUNTROWS(bridge_rendez_vous_mandataire)) > 0",
                "        ),",
                "        \"@nb_prevus\",",
                "            CALCULATE(DISTINCTCOUNT(bridge_rendez_vous_mandataire[rendez_vous_id])),",
                "        \"@nb_realises\",",
                "            CALCULATE(",
                "                DISTINCTCOUNT(bridge_rendez_vous_mandataire[rendez_vous_id]),",
                "                CROSSFILTER(bridge_rendez_vous_mandataire[rendez_vous_id], fact_rendez_vous_client[rendez_vous_id], BOTH),",
                "                fact_rendez_vous_client[flag_rendez_vous_realise] = TRUE()",
                "            ),",
                "        \"@nb_visio\",",
                "            CALCULATE(",
                "                DISTINCTCOUNT(bridge_rendez_vous_mandataire[rendez_vous_id]),",
                "                CROSSFILTER(bridge_rendez_vous_mandataire[rendez_vous_id], fact_rendez_vous_client[rendez_vous_id], BOTH),",
                "                fact_rendez_vous_client[flag_rendez_vous_realise] = TRUE(),",
                "                fact_rendez_vous_client[flag_visio] = TRUE()",
                "            ),",
                "        \"@nb_semaines\",",
                "            CALCULATE(",
                "                DISTINCTCOUNTX(dim_date, dim_date[annee] * 100 + dim_date[numero_de_la_semaine]),",
                "                CROSSFILTER(bridge_rendez_vous_mandataire[rendez_vous_id], fact_rendez_vous_client[rendez_vous_id], BOTH),",
                "                CROSSFILTER(fact_rendez_vous_client[date_rendez_vous_client], dim_date[Date], BOTH)",
                "            ),",
                "        \"@agence_id\",",
                "            CALCULATE(FIRSTNONBLANK(fact_activite_mandataire[agence_id], 1))",
                "    )",
                "",
                "// Métriques dérivées",
                "VAR _Metrics =",
                "    ADDCOLUMNS(",
                "        _Stats,",
                "        \"@taux_realisation\",    DIVIDE([@nb_realises], [@nb_prevus], 0),",
                "        \"@rdv_prevus_semaine\",  DIVIDE([@nb_prevus],   IF([@nb_semaines] > 0, [@nb_semaines], 1), 0),",
                "        \"@rdv_realises_semaine\",DIVIDE([@nb_realises], IF([@nb_semaines] > 0, [@nb_semaines], 1), 0),",
                "        \"@taux_visio\",          DIVIDE([@nb_visio],    IF([@nb_realises] > 0, [@nb_realises],  1), 0)",
                "    )",
                "",
                "// G.13 : taux réalisation RDV < 66% → CRITIQUE",
                "VAR _Alertes_G13 =",
                "    SELECTCOLUMNS(",
                "        FILTER(_Metrics, [@nb_prevus] > 0 && [@taux_realisation] < 0.66),",
                "        \"alerte_id\",      \"G13-\" & [mandataire_id] & \"-\" & FORMAT(_DateAnalyse, \"YYYYMMDD\"),",
                "        \"date_analyse\",   _DateAnalyse,",
                "        \"date_detection\", _DateAnalyse,",
                "        \"niveau_priorite\",\"CRITIQUE\",",
                "        \"categorie_alerte\",\"RDV\",",
                "        \"kpi_concerne\",   \"G.13 - Taux réalisation de rendez-vous\",",
                "        \"valeur_actuelle\",[@taux_realisation],",
                "        \"seuil_alerte\",   0.66,",
                "        \"ecart\",          [@taux_realisation] - 0.66,",
                "        \"agence_id\",      [@agence_id],",
                "        \"mandataire_id\",  [mandataire_id],",
                "        \"impact_metier\",  \"Taux de réalisation RDV insuffisant\",",
                "        \"recommandation\", \"Relancer les mandataires avec un taux de réalisation RDV inférieur à 66%\",",
                "        \"statut_alerte\",  \"Ouverte\"",
                "    )",
                "",
                "// G.14 : RDV prévus/semaine — seuil bas 15 (CRITIQUE) / haut 18 (HAUTE)",
                "VAR _Alertes_G14 =",
                "    SELECTCOLUMNS(",
                "        FILTER(_Metrics, [@nb_prevus] > 0 && [@rdv_prevus_semaine] < 18),",
                "        \"alerte_id\",      \"G14-\" & [mandataire_id] & \"-\" & FORMAT(_DateAnalyse, \"YYYYMMDD\"),",
                "        \"date_analyse\",   _DateAnalyse,",
                "        \"date_detection\", _DateAnalyse,",
                "        \"niveau_priorite\",IF([@rdv_prevus_semaine] < 15, \"CRITIQUE\", \"HAUTE\"),",
                "        \"categorie_alerte\",\"RDV\",",
                "        \"kpi_concerne\",   \"G.14 - Nombre rendez-vous prévus\",",
                "        \"valeur_actuelle\",[@rdv_prevus_semaine],",
                "        \"seuil_alerte\",   IF([@rdv_prevus_semaine] < 15, 15.0, 18.0),",
                "        \"ecart\",          [@rdv_prevus_semaine] - IF([@rdv_prevus_semaine] < 15, 15.0, 18.0),",
                "        \"agence_id\",      [@agence_id],",
                "        \"mandataire_id\",  [mandataire_id],",
                "        \"impact_metier\",  \"Volume de RDV planifiés insuffisant\",",
                "        \"recommandation\", IF([@rdv_prevus_semaine] < 15,",
                "            \"Urgence : moins de 15 RDV prévus/semaine — renforcer la prospection\",",
                "            \"Surveiller : objectif 18 RDV prévus/semaine non atteint\"),",
                "        \"statut_alerte\",  \"Ouverte\"",
                "    )",
                "",
                "// G.15 : RDV réalisés/semaine — seuil bas 12 (CRITIQUE) / haut 15 (HAUTE)",
                "VAR _Alertes_G15 =",
                "    SELECTCOLUMNS(",
                "        FILTER(_Metrics, [@nb_realises] > 0 && [@rdv_realises_semaine] < 15),",
                "        \"alerte_id\",      \"G15-\" & [mandataire_id] & \"-\" & FORMAT(_DateAnalyse, \"YYYYMMDD\"),",
                "        \"date_analyse\",   _DateAnalyse,",
                "        \"date_detection\", _DateAnalyse,",
                "        \"niveau_priorite\",IF([@rdv_realises_semaine] < 12, \"CRITIQUE\", \"HAUTE\"),",
                "        \"categorie_alerte\",\"RDV\",",
                "        \"kpi_concerne\",   \"G.15 - Nombre rendez-vous réalisés\",",
                "        \"valeur_actuelle\",[@rdv_realises_semaine],",
                "        \"seuil_alerte\",   IF([@rdv_realises_semaine] < 12, 12.0, 15.0),",
                "        \"ecart\",          [@rdv_realises_semaine] - IF([@rdv_realises_semaine] < 12, 12.0, 15.0),",
                "        \"agence_id\",      [@agence_id],",
                "        \"mandataire_id\",  [mandataire_id],",
                "        \"impact_metier\",  \"Volume de RDV réalisés insuffisant\",",
                "        \"recommandation\", IF([@rdv_realises_semaine] < 12,",
                "            \"Urgence : moins de 12 RDV réalisés/semaine\",",
                "            \"Surveiller : objectif 15 RDV réalisés/semaine non atteint\"),",
                "        \"statut_alerte\",  \"Ouverte\"",
                "    )",
                "",
                "// G.18 : taux visio > 33% par mandataire → HAUTE",
                "VAR _Alertes_G18 =",
                "    SELECTCOLUMNS(",
                "        FILTER(_Metrics, [@nb_realises] > 0 && [@taux_visio] > 0.33),",
                "        \"alerte_id\",      \"G18-\" & [mandataire_id] & \"-\" & FORMAT(_DateAnalyse, \"YYYYMMDD\"),",
                "        \"date_analyse\",   _DateAnalyse,",
                "        \"date_detection\", _DateAnalyse,",
                "        \"niveau_priorite\",\"HAUTE\",",
                "        \"categorie_alerte\",\"RDV Visio\",",
                "        \"kpi_concerne\",   \"G.18 - Taux rendez-vous en visioconférence\",",
                "        \"valeur_actuelle\",[@taux_visio],",
                "        \"seuil_alerte\",   0.33,",
                "        \"ecart\",          [@taux_visio] - 0.33,",
                "        \"agence_id\",      [@agence_id],",
                "        \"mandataire_id\",  [mandataire_id],",
                "        \"impact_metier\",  \"Sur-représentation des RDV en visioconférence\",",
                "        \"recommandation\", \"Rééquilibrer en faveur des RDV physiques (domicile) — alerter le centre d'affaires\",",
                "        \"statut_alerte\",  \"Ouverte\"",
                "    )",
                "",
                "RETURN",
                "UNION(_Alertes_G13, _Alertes_G14, _Alertes_G15, _Alertes_G18)"
              ]
            }
          }
        ]
      },
