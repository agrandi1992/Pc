        ],
        "measures": [
          {
            "name": "Flag rétrocommissionné",
            "expression": [
              "",
              "VAR DateContexteMax =",
              "    MAX(dim_date[date])",
              "VAR DateContexteMin =",
              "    MIN(dim_date[date])",
              "",
              "VAR NbCommissions =",
              "    CALCULATE(",
              "        COUNTROWS(fact_rendez_vous_client),",
              "        fact_rendez_vous_client[commission_realise] > 0,",
              "        fact_rendez_vous_client[date_rendez_vous_client] >= DateContexteMin,",
              "        fact_rendez_vous_client[date_rendez_vous_client] <= DateContexteMax",
              "    )",
              "",
              "RETURN",
              "IF(NbCommissions > 0, \"Rétrocommissionné\", \"Non rétrocommissionné\")"
            ],
            "lineageTag": "c0b3924b-c8fe-4bd2-848d-4728f657f552",
            "changedProperties": [
              {
                "property": "Name"
              }
            ],
            "displayFolder": "Pilotage Commercial - Réseau",
            "isHidden": true
          }
        ]
      },
